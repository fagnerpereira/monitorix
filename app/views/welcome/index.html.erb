<div class="max-w-4xl mx-auto px-4 py-8">
  <h1 class="text-4xl font-bold text-gray-900 mb-4">Welcome to Monitorix</h1>
  <p class="text-lg text-gray-600 mb-8">An open-source Rails application performance monitoring tool</p>

  <div class="bg-blue-50 border-l-4 border-blue-400 p-4 mb-8">
    <div class="flex">
      <div class="flex-shrink-0">
        <svg class="h-5 w-5 text-blue-400" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
        </svg>
      </div>
      <div class="ml-3">
        <p class="text-sm text-blue-700">
          Monitorix is now monitoring this application! Check out the
          <a href="/monitorix" class="font-medium underline text-blue-700 hover:text-blue-600">Dashboard</a>
          to see performance metrics, SQL queries, and more.
        </p>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <h3 class="text-lg leading-6 font-medium text-gray-900 mb-2">Database Queries</h3>
        <p class="text-sm text-gray-500 mb-4">This page made <%= @total_count + 7 %> database queries</p>
        <p class="text-xs text-gray-400">Check the Monitorix dashboard to see query details and potential N+1 issues</p>
      </div>
    </div>

    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <h3 class="text-lg leading-6 font-medium text-gray-900 mb-2">Features</h3>
        <ul class="text-sm text-gray-500 space-y-1">
          <li>✓ Request performance tracking</li>
          <li>✓ SQL query monitoring</li>
          <li>✓ N+1 query detection</li>
          <li>✓ Error tracking</li>
          <li>✓ Background job monitoring</li>
        </ul>
      </div>
    </div>
  </div>
</div>
